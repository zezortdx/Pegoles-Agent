<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required to create and run VMs with Apple Virtualization.framework.
	     Without it, VZVirtualMachine creation/start fails and the backend
	     reports error code `not_entitled`. No other entitlement is requested:
	     no bridged networking, no extra capabilities. -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
