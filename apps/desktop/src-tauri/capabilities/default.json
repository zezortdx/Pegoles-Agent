{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, release builds: exactly the app commands the product UI invokes (src/lib/tauri.ts `api`; the app ACL manifest from build.rs makes every other command a denial), listening to Core events (pegoles://event, pegoles://display-activity, pegoles://model-install), and window dragging / zoom for the overlay title bar (data-tauri-drag-region). No event emit, no filesystem, shell, clipboard, dialog or other plugin permissions. Held equal to src/ipc_commands.rs by the tests in src/ipc_acl.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-status",
    "allow-create-computer",
    "allow-start-computer",
    "allow-pause-computer",
    "allow-resume-computer",
    "allow-stop-computer",
    "allow-reset-computer",
    "allow-destroy-computer",
    "allow-list-events",
    "allow-read-boot-log",
    "allow-get-host-capabilities",
    "allow-accessibility-display",
    "allow-suggested-effects",
    "allow-display-set-geometry",
    "allow-display-detach",
    "allow-take-control",
    "allow-return-control",
    "allow-create-task",
    "allow-list-tasks",
    "allow-run-task",
    "allow-cancel-task",
    "allow-get-model-settings",
    "allow-enter-api-key",
    "allow-clear-api-key",
    "allow-set-model-settings",
    "allow-get-intelligence",
    "allow-set-provider",
    "allow-install-local-model",
    "allow-cancel-local-model-install",
    "allow-remove-local-model",
    "allow-cancel-agent-input",
    "allow-capture-screen",
    "allow-install-computer-image",
    "allow-cancel-computer-image-install",
    "allow-get-onboarding",
    "allow-set-onboarding-step",
    "allow-finish-onboarding",
    "allow-system-check",
    "allow-fix-virtualization",
    "allow-restart-to-finish-setup"
  ]
}
