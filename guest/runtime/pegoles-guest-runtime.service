# Pegoles guest runtime: the host<->guest control plane over vsock.
# Runs unprivileged. Its ONLY capability is CAP_NET_BIND_SERVICE, used to
# dial the host from a reserved vsock source port (<= 1023). The host
# accepts no other peer, so no other guest process (including apps the
# agent drives) can impersonate the runtime. See docs/GUEST_PROTOCOL.md.
[Unit]
Description=Pegoles Guest Runtime (host<->guest control plane over vsock)
After=systemd-user-sessions.service pegoles-weston.service
Wants=systemd-user-sessions.service pegoles-weston.service
# A guest app killing the runtime in a loop must not leave the unit
# permanently failed (default start limit: 5 starts / 10 s).
StartLimitIntervalSec=0

[Service]
Type=simple
User=pegoles
SupplementaryGroups=input
Environment=XDG_RUNTIME_DIR=/run/pegoles
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/pegoles-guest-runtime
Restart=always
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_VSOCK AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
UMask=0077
ReadOnlyPaths=/etc/os-release /etc/hostname

[Install]
WantedBy=multi-user.target
