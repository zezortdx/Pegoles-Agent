#cloud-config
# Pegoles Guest Image v2 provisioning (BUILD TIME ONLY).
# Runs once on first boot with this seed ISO attached:
#  - guest runtime v2 + fixture binaries (offline, from seed ISO);
#  - version-pinned weston/foot stack (offline .debs, from seed ISO);
#  - udev rule + groups for uinput (narrow: input group only);
#  - us(intl) keyboard layout matching the runtime dead-key tables;
#  - weston.ini (1440x900, screenshooter-capable) + units;
#  - fixture autostart (dev/test only);
# then disables cloud-init and powers off for snapshot.
# The builder seals the disk as a NEW versioned v2 image; v0.1 is
# never mutated. The normal lifecycle never attaches a seed and never
# runs cloud-init.
hostname: pegoles
manage_etc_hosts: true

users:
  - name: pegoles
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
    groups: [input, video, render]

write_files:
  - path: /etc/systemd/system/pegoles-guest-runtime.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Pegoles Guest Runtime (host<->guest control plane over vsock)
      After=systemd-user-sessions.service
      Wants=systemd-user-sessions.service

      [Service]
      Type=simple
      User=pegoles
      SupplementaryGroups=input
      Environment=XDG_RUNTIME_DIR=/run/pegoles
      Environment=WAYLAND_DISPLAY=wayland-0
      ExecStart=/usr/local/bin/pegoles-guest-runtime
      Restart=on-failure
      RestartSec=5s
      CapabilityBoundingSet=
      AmbientCapabilities=
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectHome=true
      ProtectSystem=strict
      ProtectKernelTunables=true
      ProtectKernelModules=true
      ProtectControlGroups=true
      LockPersonality=true
      RestrictSUIDSGID=true
      RestrictRealtime=true
      ReadOnlyPaths=/etc/os-release /etc/hostname

      [Install]
      WantedBy=multi-user.target
  - path: /etc/udev/rules.d/99-pegoles-input.rules
    owner: root:root
    permissions: '0644'
    content: |
      # Pegoles input device access (Image v2).
      # Narrow rule: the pegoles user (via the input group) may open the
      # uinput misc device to create the single "Pegoles Agent Input"
      # virtual device. No MODE=0666 anywhere. (No SUBSYSTEM match:
      # misc-device uevents vary; KERNEL match alone is precise enough
      # for the single uinput node.)
      KERNEL=="uinput", GROUP="input", MODE="0660"
  - path: /etc/xdg/weston/weston.ini
    owner: root:root
    permissions: '0644'
    content: |
      # Pegoles Guest Image v2 — Weston compositor configuration.
      # --debug is REQUIRED: weston 14 only exposes the
      # weston_screenshooter global with the debug protocol extension.
      # Scope note: guest-local clients only; the guest is already
      # untrusted and isolated, so this exposes nothing beyond the VM.
      # Backend is chosen by /usr/local/bin/pegoles-weston: DRM when VZ
      # attaches a virtio-gpu (libinput seat, so the uinput agent device
      # reaches clients), headless otherwise (capture only; headless has
      # no libinput seat). Both use the pixman renderer: headless's
      # default noop renderer never completes framebuffer captures.
      [core]
      shell=desktop-shell.so
      xwayland=false
      require-input=false

      [shell]
      locking=false
      background-color=0x000000
      panel-location=none

      [output]
      name=all
      mode=1440x900

      [keyboard]
      # MUST match guest/runtime/src/input.rs dead-key tables.
      keymap_layout=us
      keymap_variant=intl

      [libinput]
      touchscreen_calibrator=false
  - path: /usr/local/bin/pegoles-weston
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/sh
      # Pegoles Image v2 compositor launcher. DRM + libinput when a GPU
      # is attached (agent uinput input works); headless fallback keeps
      # capture alive without one. virtio-gpu may probe after us: wait
      # up to 5 s for the card before falling back.
      COMMON="--shell=desktop-shell.so --socket=wayland-0 --config=/etc/xdg/weston/weston.ini --renderer=pixman --debug --log=/var/log/pegoles/weston.log"
      i=0
      while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 50 ]; do
        sleep 0.1
        i=$((i + 1))
      done
      if [ -e /dev/dri/card0 ]; then
        exec /usr/bin/weston --backend=drm-backend.so $COMMON
      fi
      exec /usr/bin/weston --backend=headless-backend.so --width=1440 --height=900 $COMMON
  - path: /etc/systemd/system/pegoles-weston.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Pegoles Weston compositor (Image v2 graphical session)
      After=systemd-user-sessions.service seatd.service
      Wants=seatd.service

      [Service]
      Type=simple
      User=pegoles
      Group=pegoles
      SupplementaryGroups=input video render
      RuntimeDirectory=pegoles
      Environment=XDG_RUNTIME_DIR=/run/pegoles
      Environment=WAYLAND_DISPLAY=wayland-0
      Environment=XKB_DEFAULT_LAYOUT=us
      Environment=XKB_DEFAULT_VARIANT=intl
      ExecStart=/usr/local/bin/pegoles-weston
      Restart=on-failure
      RestartSec=3s
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/run/pegoles
      LogsDirectory=pegoles

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/pegoles-fixture.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Pegoles deterministic input fixture (dev/test only)
      After=pegoles-weston.service
      Requires=pegoles-weston.service

      [Service]
      Type=simple
      User=pegoles
      Group=pegoles
      Environment=XDG_RUNTIME_DIR=/run/pegoles
      Environment=WAYLAND_DISPLAY=wayland-0
      Environment=PEGOLES_FIXTURE_LOG=/tmp/pegoles-fixture.log
      Environment=TERM=foot
      # Fullscreen: no panel/title bar offset, so the fixture's proportional
      # layout maps 1:1 onto normalized screen coordinates.
      ExecStart=/usr/bin/foot --fullscreen /usr/local/bin/pegoles-input-fixture
      Restart=on-failure
      RestartSec=3s
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=false

      [Install]
      WantedBy=multi-user.target
  - path: /etc/modules-load.d/pegoles.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Ensure the uinput module backing /dev/uinput is present.
      uinput

runcmd:
  # Mount the seed ISO once; everything below comes from it (offline).
  - mkdir -p /mnt/pegoles-seed && mount -o ro -L cidata /mnt/pegoles-seed
  - cp /mnt/pegoles-seed/pegoles-guest-runtime /usr/local/bin/pegoles-guest-runtime && chmod 0755 /usr/local/bin/pegoles-guest-runtime
  - cp /mnt/pegoles-seed/pegoles-input-fixture /usr/local/bin/pegoles-input-fixture && chmod 0755 /usr/local/bin/pegoles-input-fixture
  - /usr/local/bin/pegoles-guest-runtime --version
  # Version-pinned graphical stack (dpkg fails fast on missing deps —
  # extend the seed bundle and rebuild the ISO, never apt online here).
  - dpkg -i /mnt/pegoles-seed/debs/*.deb
  - weston --version && foot --version
  # Sanity gates: udev, uinput module source, XKB data present.
  - command -v udevadm && (modinfo uinput || ls /dev/uinput)
  - test -f /usr/share/X11/xkb/rules/evdev.lst
  - umount /mnt/pegoles-seed && rmdir /mnt/pegoles-seed
  # Activate udev rule + groups + units.
  - udevadm control --reload-rules && udevadm trigger --subsystem-match=misc || true
  - systemctl daemon-reload
  - systemctl enable pegoles-guest-runtime.service pegoles-weston.service pegoles-fixture.service seatd.service || systemctl enable pegoles-guest-runtime.service pegoles-weston.service pegoles-fixture.service
  # Serial console on the virtio-console (hvc0) for boot diagnostics.
  # GuestReady never depends on serial; this is diagnostics only.
  - grep -q 'console=hvc0' /etc/default/grub || sed -i 's/^GRUB_CMDLINE_LINUX="\(.*\)"/GRUB_CMDLINE_LINUX="\1 console=hvc0"/' /etc/default/grub
  - update-grub
  # cloud-init did its one job: disable it for every later boot,
  # then power off for snapshot. NOTE: runcmd `poweroff` is refused
  # while systemd is still booting — use the power_state module, which
  # synchronizes with boot completion itself.
  - systemctl disable cloud-init cloud-config cloud-final cloud-init-local || true
  - touch /etc/cloud/cloud-init.disabled

power_state:
  mode: poweroff
  timeout: 120
  condition: true

final_message: "Pegoles v2 provisioning complete, powering off for snapshot."
