#cloud-config
# Pegoles Guest Image provisioning (BUILD TIME ONLY; v0.3 layout).
# Runs once on first boot with this seed ISO attached:
#  - guest runtime v2 + fixture binaries (offline, from seed ISO);
#  - version-pinned weston/foot stack (offline .debs, from seed ISO);
#  - udev rule + groups for uinput (narrow: input group only);
#  - us(intl) keyboard layout matching the runtime dead-key tables;
#  - weston.ini (1440x900, screenshooter-capable) + units;
#  - units from seed/units: runtime (reserved-port auth), workspace
#    terminal (enabled), input fixture (installed, dev/test only);
#  - images 0.4 / x64-0.2 (browser, docs/EGRESS.md): pinned chromium debs,
#    system user pegoles-egress, root-owned managed policy, forwarder
#    binary + units, weston.ini with the browser launcher (from the seed);
# then disables cloud-init and powers off for snapshot.
# The builder seals the disk as a NEW versioned v2 image; v0.1 is
# never mutated. The normal lifecycle never attaches a seed and never
# runs cloud-init.
hostname: pegoles
manage_etc_hosts: true

users:
  - name: pegoles
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
    groups: [input, video, render]
  # Owns the egress forwarder process and exactly one policy file. No login,
  # no home, no extra groups, no password.
  - name: pegoles-egress
    system: true
    shell: /usr/sbin/nologin
    homedir: /nonexistent
    no_create_home: true
    lock_passwd: true
    primary_group: pegoles-egress

write_files:
  - path: /etc/udev/rules.d/99-pegoles-input.rules
    owner: root:root
    permissions: '0644'
    content: |
      # Pegoles input device access (Image v2).
      # Narrow rule: the pegoles user (via the input group) may open the
      # uinput misc device to create the single "Pegoles Agent Input"
      # virtual device. No MODE=0666 anywhere. (No SUBSYSTEM match:
      # misc-device uevents vary; KERNEL match alone is precise enough
      # for the single uinput node.)
      KERNEL=="uinput", GROUP="input", MODE="0660"
  - path: /usr/local/bin/pegoles-weston
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/sh
      # Pegoles Image v2 compositor launcher. DRM + libinput when a GPU
      # is attached (agent uinput input works); headless fallback keeps
      # capture alive without one. virtio-gpu may probe after us: wait
      # up to 5 s for the card before falling back.
      COMMON="--shell=desktop-shell.so --socket=wayland-0 --config=/etc/xdg/weston/weston.ini --renderer=pixman --debug --log=/var/log/pegoles/weston.log"
      i=0
      while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 50 ]; do
        sleep 0.1
        i=$((i + 1))
      done
      if [ -e /dev/dri/card0 ]; then
        exec /usr/bin/weston --backend=drm-backend.so $COMMON
      fi
      exec /usr/bin/weston --backend=headless-backend.so --width=1440 --height=900 $COMMON
  - path: /etc/systemd/system/pegoles-weston.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Pegoles Weston compositor (Image v2 graphical session)
      After=systemd-user-sessions.service seatd.service
      Wants=seatd.service

      [Service]
      Type=simple
      User=pegoles
      Group=pegoles
      SupplementaryGroups=input video render
      RuntimeDirectory=pegoles
      Environment=XDG_RUNTIME_DIR=/run/pegoles
      Environment=WAYLAND_DISPLAY=wayland-0
      Environment=XKB_DEFAULT_LAYOUT=us
      Environment=XKB_DEFAULT_VARIANT=intl
      ExecStart=/usr/local/bin/pegoles-weston
      Restart=on-failure
      RestartSec=3s
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/run/pegoles
      LogsDirectory=pegoles

      [Install]
      WantedBy=multi-user.target
  - path: /etc/modules-load.d/pegoles.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Ensure the uinput module backing /dev/uinput is present.
      uinput

runcmd:
  # Mount the seed ISO once; everything below comes from it (offline).
  - mkdir -p /mnt/pegoles-seed && mount -o ro -L cidata /mnt/pegoles-seed
  - cp /mnt/pegoles-seed/pegoles-guest-runtime /usr/local/bin/pegoles-guest-runtime && chmod 0755 /usr/local/bin/pegoles-guest-runtime
  - cp /mnt/pegoles-seed/pegoles-input-fixture /usr/local/bin/pegoles-input-fixture && chmod 0755 /usr/local/bin/pegoles-input-fixture
  # Units live as files in the repo (scripts/build-guest-image/seed/units):
  # the same bytes feed this build and patch-image.sh.
  - install -m 0644 -o root -g root /mnt/pegoles-seed/units/*.service /mnt/pegoles-seed/units/*.path /etc/systemd/system/
  - install -d -m 0755 -o root -g root /etc/xdg/weston
  - install -m 0644 -o root -g root /mnt/pegoles-seed/weston/weston.ini /etc/xdg/weston/weston.ini
  - install -m 0644 -o root -g root /mnt/pegoles-seed/sysctl/60-pegoles-hardening.conf /etc/sysctl.d/
  - /usr/local/bin/pegoles-guest-runtime --version
  # Version-pinned graphical stack (dpkg fails fast on missing deps —
  # extend the seed bundle and rebuild the ISO, never apt online here).
  - dpkg -i /mnt/pegoles-seed/debs/*.deb
  - weston --version && foot --version
  # Browser (images 0.4 / x64-0.2). The managed-policy tree is root-owned and
  # not writable by the agent's user; the single file pegoles-egress-ca.json
  # is owned by pegoles-egress (the forwarder writes it in place, the
  # directory stays closed). It sorts before pegoles.json, which therefore
  # wins any key both define.
  - test -x /usr/bin/chromium && chromium --version
  - test -f /usr/share/icons/hicolor/48x48/apps/chromium.png
  - install -d -m 0755 -o root -g root /etc/chromium /etc/chromium/policies /etc/chromium/policies/managed /usr/local/lib/pegoles
  - install -m 0644 -o root -g root /mnt/pegoles-seed/browser/pegoles-policy.json /etc/chromium/policies/managed/pegoles.json
  - install -m 0644 -o pegoles-egress -g pegoles-egress /mnt/pegoles-seed/browser/pegoles-egress-ca.json /etc/chromium/policies/managed/pegoles-egress-ca.json
  - install -m 0755 -o root -g root /mnt/pegoles-seed/browser/pegoles-open-browser /usr/local/bin/pegoles-open-browser
  - install -m 0755 -o root -g root /mnt/pegoles-seed/pegoles-egress-forwarder /usr/local/lib/pegoles/pegoles-egress-forwarder
  - test "$(stat -c '%U:%G:%a' /etc/chromium /etc/chromium/policies /etc/chromium/policies/managed | sort -u)" = "root:root:755"
  - test "$(stat -c '%U:%a' /etc/chromium/policies/managed/pegoles.json)" = "root:644"
  - id pegoles-egress
  # Sanity gates: udev, uinput module source, XKB data present.
  - command -v udevadm && (modinfo uinput || ls /dev/uinput)
  - test -f /usr/share/X11/xkb/rules/evdev.lst
  - umount /mnt/pegoles-seed && rmdir /mnt/pegoles-seed
  # Activate udev rule + groups + units.
  - udevadm control --reload-rules && udevadm trigger --subsystem-match=misc || true
  - systemctl daemon-reload
  - systemctl enable pegoles-guest-runtime.service pegoles-weston.service pegoles-workspace.service pegoles-egress-forwarder.service pegoles-browser.path seatd.service || systemctl enable pegoles-guest-runtime.service pegoles-weston.service pegoles-workspace.service pegoles-egress-forwarder.service pegoles-browser.path
  # Serial console for boot diagnostics (GuestReady never depends on it):
  # the virtio-console (hvc0) under Virtualization.framework (arm64), COM1
  # (ttyS0) under Hyper-V (amd64).
  # amd64 (Windows) also: the host connects to the runtime, which listens
  # on its privileged vsock port (pegoles.transport=listen, see
  # docs/WINDOWS_ARCHITECTURE.md); hv_sock is the vsock transport; the
  # Hyper-V storage and bus drivers are in the initramfs (the root disk is
  # SCSI there). Weston gets its DRM seat from Hyper-V's synthetic video
  # (hyperv_drm, loaded by the bus), so agent input reaches clients
  # through libinput as on macOS.
  - |
    if [ "$(dpkg --print-architecture)" = amd64 ]; then
      grep -q 'pegoles.transport=listen' /etc/default/grub || sed -i 's/^GRUB_CMDLINE_LINUX="\(.*\)"/GRUB_CMDLINE_LINUX="\1 console=ttyS0,115200 pegoles.transport=listen"/' /etc/default/grub
      printf 'hv_sock\n' > /etc/modules-load.d/pegoles-hyperv.conf
      printf 'hv_vmbus\nhv_storvsc\nhv_sock\n' >> /etc/initramfs-tools/modules
      update-initramfs -u
    else
      grep -q 'console=hvc0' /etc/default/grub || sed -i 's/^GRUB_CMDLINE_LINUX="\(.*\)"/GRUB_CMDLINE_LINUX="\1 console=hvc0"/' /etc/default/grub
    fi
  - update-grub
  # cloud-init did its one job: disable it for every later boot,
  # then power off for snapshot. NOTE: runcmd `poweroff` is refused
  # while systemd is still booting — use the power_state module, which
  # synchronizes with boot completion itself.
  - systemctl disable cloud-init cloud-config cloud-final cloud-init-local || true
  - touch /etc/cloud/cloud-init.disabled

power_state:
  mode: poweroff
  timeout: 120
  condition: true

final_message: "Pegoles v2 provisioning complete, powering off for snapshot."
